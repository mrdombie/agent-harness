{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "compare step answer",
  "description": "The new renders held beside what was approved. Every difference is either fixed, or carries the reason it stands \u2014 and a difference with neither is the drift this step exists to catch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step",
    "skills",
    "status",
    "approved"
  ],
  "properties": {
    "step": {
      "const": "compare"
    },
    "skills": {
      "description": "Every Superpowers skill invoked in this step. The driver cross-checks this against the Skill calls in the run log, so a claim here the log does not show is a failed step.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^superpowers:[a-z][a-z-]*$"
      }
    },
    "status": {
      "enum": [
        "compared",
        "park"
      ]
    },
    "approved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "description": "What was approved, and where that approval is recorded.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "renders": {
      "description": "The renders this comparison was made against. Both themes, the real route, the states the change touches. A comparison with no render is a reasoning, not an observation.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "theme"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "enum": [
              "light",
              "dark"
            ]
          }
        }
      }
    },
    "differences": {
      "description": "Empty means parity, and it is a claim the renders have to support.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "fixed"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "fixed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "fixed": {
              "const": false
            }
          },
          "required": [
            "fixed"
          ]
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      }
    },
    "question": {
      "description": "Why this step cannot finish. Answerable in a line: a yes/no or a pick.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "compared"
      }
    }
  },
  "then": {
    "required": [
      "renders",
      "differences"
    ]
  },
  "else": {
    "required": [
      "question"
    ]
  }
}
