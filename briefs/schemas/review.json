{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review step answer",
  "description": "A verdict, and the blockers behind it. SHIP with blockers and BLOCKED without them are both refused: the verdict is read off the list, never typed beside it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step",
    "skills",
    "status",
    "round",
    "verdict",
    "blockers"
  ],
  "properties": {
    "step": {
      "const": "review"
    },
    "skills": {
      "description": "Every Superpowers skill invoked in this step. The driver cross-checks this against the Skill calls in the run log, so a claim here the log does not show is a failed step.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^superpowers:[a-z][a-z-]*$"
      }
    },
    "status": {
      "enum": [
        "reviewed",
        "park"
      ]
    },
    "round": {
      "description": "Which review round this is. The driver allows two; leftovers after that become a follow-up.",
      "type": "integer",
      "minimum": 1
    },
    "verdict": {
      "enum": [
        "SHIP",
        "BLOCKED"
      ]
    },
    "blockers": {
      "description": "A blocker is a dead control, a broken flow, or a data-honesty failure. Anything else is a follow-up, not a blocker.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "line",
          "summary",
          "fix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "question": {
      "description": "Why this step cannot finish. Answerable in a line: a yes/no or a pick.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "SHIP"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
