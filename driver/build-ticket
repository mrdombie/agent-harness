#!/usr/bin/env bash
# build-ticket — one ticket, from the claim to the hand-off, with the driver
# deciding what happens next.
#
#   build-ticket <ticket> [--restart] [--steps "start plan …"]
#   build-ticket <ticket> --repair <brief-file>   a red or clashing PR, on its own branch
#   build-ticket <ticket> --repair-class <class>  the same, for a healing run with no note
#   build-ticket <ticket> --brief <brief-file>    a repair if the ticket has an open PR, else a build with the brief
#
# THIS FILE IS THE CHANGE THE EPIC IS ABOUT. Until now the order of the work was
# a list an agent read in 49,657 words of instructions and then chose from: the
# "mandatory" Superpowers steps were used in 3 of 161 runs, and test-first in
# none of them. Not because the instructions were unclear — because deciding the
# next step was the model's job, and a model under pressure decides to get on
# with it. Here the order is a list in code, walked to the end, and the only
# thing the model is asked is the thinking inside one step.
#
# The seven, and what each returns, live in driver-env.sh. What this file adds is
# the three rules between them:
#
#   1. IN ORDER, AND EVERY ONE. A step is not skippable. A step named in the
#      order whose file or function is missing is a REFUSAL, by name — because a
#      walk that quietly skips what it cannot find reports exactly like a walk
#      where that step passed, and "the gate did not run" has to look different
#      from "the gate found nothing".
#   2. NOTHING IS LOST ON A STOP. Each finished step is written to the record
#      before the next one starts, so a killed run resumes at the one after it
#      rather than re-taking the claim and re-cutting the tree.
#   3. ANY REFUSAL PARKS. There is no fall-through. A step that refuses, asks a
#      question, skipped its Skill or answered in the wrong shape ends the run
#      through park.sh — pushed, draft pull request, resume brief, label, claim
#      released — so the work is recoverable by somebody who is not this process.
#
# A review that grades something critical, major or minor is the one code that is not an ending: it rewinds
# to the build step and the steps between are reopened, which is what a rework
# round is. That loop is bounded here as well as inside the build step, because
# a step returning "go back" forever is indistinguishable from a hung agent.
set -uo pipefail

DRIVER_HOME_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DRIVER_HOME_SELF/driver-env.sh" || exit 1
. "$DRIVER_HOME_SELF/state.sh" || exit 1

# The step files. A seam, so a test can walk the orchestrator over recorders and
# get a clean answer about control flow — the same reason every call out of the
# swarm layer is overridable.
DRIVER_STEPS_DIR="${DRIVER_STEPS_DIR:-$DRIVER_HOME_SELF/steps}"

die() { echo "build-ticket: $*" >&2; exit 2; }

TICKET=""; RESTART=0; REPAIR_BRIEF=""; REPAIR_CLASS=""; RUN_BRIEF=""; REPAIR_SOURCE=caller
while [ $# -gt 0 ]; do
  case "$1" in
    --restart) RESTART=1; shift ;;
    --repair)  REPAIR_BRIEF="${2:?--repair needs a brief file}"; shift 2 ;;
    --repair-class) REPAIR_CLASS="${2:?--repair-class needs a class}"; shift 2 ;;
    --brief)   RUN_BRIEF="${2:?--brief needs a brief file}"; shift 2 ;;
    --steps)   DRIVER_STEPS="${2:?--steps needs a list}"; shift 2 ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)        die "unknown flag $1" ;;
    *)         TICKET="$1"; shift ;;
  esac
done
[ -n "$TICKET" ] || die "need a ticket number"
case "$TICKET" in *[!0-9]*) die "'$TICKET' is not a ticket number" ;; esac
export DRIVER_TICKET="$TICKET"

# driver_keep_brief <src> <dst> — the brief onto the record, capped. Every AI step is
# handed it, so a brief of any size is paid for on every call; past the cap the steps
# read its first DRIVER_BRIEF_MAX_BYTES with a notice saying so, and the whole of it
# is kept beside, at <dst minus .md>.full.md.
driver_keep_brief() {
  local src="$1" dst="$2" max="${DRIVER_BRIEF_MAX_BYTES:-4096}" n
  n=$(wc -c < "$src" | tr -d ' ')
  if [ "${n:-0}" -le "$max" ]; then cp "$src" "$dst"; return; fi
  cp "$src" "${dst%.md}.full.md"
  { head -c "$max" "$src"; printf '\n\n[… this brief was %s bytes; only its first %s are here. The whole of it: %s]\n' "$n" "$max" "${dst%.md}.full.md"; } > "$dst"
  driver_say "   brief: $n bytes, cut to $max for the steps; the whole of it is at ${dst%.md}.full.md"
}

# ---- the record first ------------------------------------------------------------
# AN UNSHIPPED BUILD ON THE RECORD IS RESUMED AS A BUILD, whatever the caller called
# the run. A build that parks on a question opens a draft PR to keep its work, so the
# answer comes back looking like a repair (a brief on a ticket with a PR, or a repair
# class from a requeue that saw the PR). Routed on the PR, the walk would skip the
# steps the build had left — the design compare a person sanctions, the build's own
# red-then-green proof — and ship it. The record says which walk this is; the PR does not.
# AND THE RECORD IS CHECKED AGAINST THE LIVE PR FIRST. A record a person or /claim has
# moved on from (another branch, a PR made ready, a head with commits the record never
# saw) is stale: it moves aside, and the run is a fresh repair round from origin.
UNSHIPPED_BUILD=0
_unshipped='(.mode // "build") != "repair" and ((.done // []) | length > 0) and ((.done // []) | index("ship") == null)'
if { [ -n "$REPAIR_CLASS" ] || [ -n "$REPAIR_BRIEF" ] || [ -n "$RUN_BRIEF" ]; } \
   && jq -e "$_unshipped" "$DRIVER_DIR/$TICKET/state.json" >/dev/null 2>&1 \
   && _live=$(driver_open_prs_for "$TICKET") && [ -n "$_live" ]; then
  _stale=$(driver_record_diverged "$TICKET" "$(printf '%s\n' "$_live" | head -1)")
  if [ -n "$_stale" ]; then
    _aside="$DRIVER_DIR/$TICKET.stale-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    mv "$DRIVER_DIR/$TICKET" "$_aside"
    echo "build-ticket: #$TICKET's record is stale — $_stale. It is kept at $_aside; this run is a fresh repair round from origin." >&2
  fi
  unset _stale _aside
fi
unset _live
if jq -e "$_unshipped" "$DRIVER_DIR/$TICKET/state.json" >/dev/null 2>&1; then
  UNSHIPPED_BUILD=1
  if [ -n "$REPAIR_CLASS" ]; then
    echo "build-ticket: #$TICKET has an unshipped build on its record — resuming the build, not a $REPAIR_CLASS repair" >&2
    REPAIR_CLASS=""
  fi
  if [ -n "$REPAIR_BRIEF" ]; then
    echo "build-ticket: #$TICKET has an unshipped build on its record — resuming the build with this brief, not a repair" >&2
    RUN_BRIEF="$REPAIR_BRIEF"; REPAIR_BRIEF=""
  fi
fi

# ---- what a run was handed ----------------------------------------------------
# `--repair-class <class>` is a healing run that came with no note: still a repair of
# the open PR, never a fresh build, with a brief that says so. `--brief <file>` is a
# run a caller handed a brief without saying what kind: the ticket's open PR decides —
# with one it is a repair, without one it is a build with the brief put in front of
# every step (an owner's answer, a resume after a cut).
if [ -n "$REPAIR_CLASS" ]; then
  case "$REPAIR_CLASS" in repair|approved-merge) ;; *) die "--repair-class takes repair or approved-merge, not '$REPAIR_CLASS'" ;; esac
  mkdir -p "$DRIVER_DIR/$TICKET"
  REPAIR_BRIEF="$DRIVER_DIR/$TICKET/repair-brief.class"
  printf 'No brief came with this run: #%s was queued as %s with no note. Read the pull request'"'"'s own state: its checks, its merge state, its review.\n' \
    "$TICKET" "$REPAIR_CLASS" > "$REPAIR_BRIEF"
  REPAIR_SOURCE=class
fi
if [ -n "$RUN_BRIEF" ] && [ "$UNSHIPPED_BUILD" -eq 1 ]; then
  [ -s "$RUN_BRIEF" ] || die "--brief names '$RUN_BRIEF', which is missing or empty — a run whose brief is lost would build as if it had none"
elif [ -n "$RUN_BRIEF" ]; then
  [ -s "$RUN_BRIEF" ] || die "--brief names '$RUN_BRIEF', which is missing or empty — a run whose brief is lost would build as if it had none"
  # ASKED A FEW TIMES, AND NEVER LOST. The coordinator took the queue entry off when it
  # spawned this run, so an exit here with the brief dropped would lose an owner's
  # answer. A lookup that keeps failing puts the ticket back on the queue, with its
  # brief as the note, and says so.
  _tries=0
  until _prs=$(driver_open_prs_for "$TICKET"); do
    _tries=$((_tries+1))
    if [ "$_tries" -ge "${DRIVER_LOOKUP_TRIES:-3}" ]; then
      if bash "$KIT_ROOT/scripts/coordinator-queue.sh" add "$TICKET" --note "$(driver_brief_note "$RUN_BRIEF")" --first >/dev/null 2>&1; then
        die "--brief: could not ask GitHub whether #$TICKET has an open pull request ($_tries tries) — #$TICKET is back on the queue, first in its priority, with its brief as the note"
      fi
      mkdir -p "$DRIVER_DIR/$TICKET"; cp "$RUN_BRIEF" "$DRIVER_DIR/$TICKET/brief-unrouted.md" 2>/dev/null
      die "--brief: could not ask GitHub whether #$TICKET has an open pull request ($_tries tries), and could not put it back on the queue — the brief is kept at $DRIVER_DIR/$TICKET/brief-unrouted.md"
    fi
    sleep "${DRIVER_LOOKUP_RETRY_SEC:-5}"
  done
  unset _tries
  if [ -n "$_prs" ]; then REPAIR_BRIEF="$RUN_BRIEF"; RUN_BRIEF=""; fi
  unset _prs
fi

# ---- a repair: the PR that exists, not a fresh build --------------------------
# `--repair <brief>` is how a red or clashing pull request comes back to the driver.
# A different order, entered through `reenter` (the PR's own branch, at origin's
# head) in place of `start` (a fresh branch from the trunk): reenter, repair, then
# the same fix, self-check, review, record and ship every ticket gets. The brief
# is the reason it was sent and is never dropped: it is copied onto the record, and
# a brief that cannot be read is a refusal, because a repair with its reason
# missing would be a guess at what is wrong.
if [ -n "$REPAIR_BRIEF" ]; then
  [ -s "$REPAIR_BRIEF" ] || die "--repair names '$REPAIR_BRIEF', which is missing or empty — a repair without its brief would be a guess at what is wrong"
  # A DRAFT THE DRIVER NEVER BUILT IS NOT A REPAIR: readied and armed, it would land
  # work its author left unfinished. The prose claim resumes it; a brief goes back on
  # the queue so it is not lost, and the next spawn routes it there.
  if ! driver_built "$TICKET" \
     && [ "$(driver_open_prs_for "$TICKET" 2>/dev/null | head -1 | cut -f5)" = true ]; then
    if [ "$REPAIR_SOURCE" = caller ]; then
      bash "$KIT_ROOT/scripts/coordinator-queue.sh" add "$TICKET" --note "$(driver_brief_note "$REPAIR_BRIEF")" --first >/dev/null 2>&1 \
        || { mkdir -p "$DRIVER_DIR/$TICKET"; cp "$REPAIR_BRIEF" "$DRIVER_DIR/$TICKET/brief-unrouted.md" 2>/dev/null; }
    else
      # A healing class too: back on the queue as that class, which the spawner routes to prose.
      bash "$KIT_ROOT/scripts/coordinator-queue.sh" add "$TICKET" --class "$REPAIR_CLASS" --first >/dev/null 2>&1 || true
    fi
    die "#$TICKET has an open pull request that is a draft the driver did not build, and a repair never readies one. The prose claim resumes it; a brief the caller sent is back on the queue, or kept at $DRIVER_DIR/$TICKET/brief-unrouted.md."
  fi
  DRIVER_STEPS="${DRIVER_REPAIR_STEPS:-reenter repair fix self-check review record ship}"
  DRIVER_ALWAYS_STEPS="${DRIVER_ALWAYS_STEPS:-reenter}"
fi

# ---- load the steps, refusing by name --------------------------------------
# Park first: it is the exit from every other step, so a run that cannot park is
# a run that must not start. Loading it late would mean discovering that at the
# exact moment it was needed.
# driver_last_refusal — the last ✋ or ⏳ line this step wrote to the log, so a refusal
# that set no park_note still parks or requeues with its reason. Any prefix, not only
# the step's own: the review step's refusals are push-requires' lines.
driver_last_refusal() {
  tail -n +"${RUN_LOG_FROM:-1}" "$(driver_state_dir "$TICKET")/log" 2>/dev/null \
    | grep -E "^[^ ]* (✋|⏳) " | tail -1 | sed -E "s/^[^ ]* (✋|⏳) //" | cut -c1-400
}

# driver_requeue <ticket> <reason> [keep] — the exit for a stop that is nobody's to
# answer and that a later run clears by itself: the plan's usage limit, a GitHub read
# that failed, a claim another run holds. Not a park: no label, no draft pull request,
# no question. The record and the worktree stay, so the next spawn resumes at the step
# that stopped; the ticket goes back on the coordinator's queue at the front with what
# this run was handed. The claim is released last, unless `keep`: a step that stopped
# before taking the claim would be releasing a peer's. The reason is said, on the log
# and the record, because a requeue that says nothing reads as a run that did nothing.
driver_requeue() { # <ticket> <reason> [keep]
  local t="${1:?driver_requeue: need a ticket}" reason="${2:-a stop nobody has to answer}" keep="${3:-}"
  local q="${DRIVER_QUEUE:-$KIT_ROOT/scripts/coordinator-queue.sh}" cls=new note="" rb="" queued=0
  export DRIVER_TICKET="$t"
  if [ "${REPAIR_SOURCE:-}" = class ] && [ -n "${REPAIR_CLASS:-}" ]; then
    cls="$REPAIR_CLASS"
  elif [ "$(driver_state_get "$t" mode)" = repair ]; then
    cls=repair
    [ "$(driver_state_get "$t" repair_brief_source)" = class ] || rb=$(driver_state_get "$t" repair_brief)
    [ -n "$rb" ] || rb="${REPAIR_BRIEF:-}"
  else
    rb=$(driver_state_get "$t" run_brief); [ -n "$rb" ] || rb="${RUN_BRIEF:-}"
  fi
  [ -n "$rb" ] && [ -s "$rb" ] && note=$(driver_brief_note "$rb")
  driver_state_set "$t" requeued "$(swarm_stamp) $reason"
  if bash "$q" add "$t" --class "$cls" ${note:+--note "$note"} --first >/dev/null 2>&1; then
    queued=1
  else
    if [ -n "$rb" ] && [ -s "$rb" ]; then mkdir -p "$DRIVER_DIR/$t"; cp "$rb" "$DRIVER_DIR/$t/brief-unrouted.md" 2>/dev/null; fi
    driver_say "   requeue: #$t could not be put back on the queue ($q) — the next tick's refresh picks it up from the board"
  fi
  [ "$keep" = keep ] || bash "$CL" release "$t" >/dev/null 2>&1 || true
  driver_say "↻ #$t requeued for the next tick$([ "$queued" -eq 1 ] && echo ", at the front of its priority as $cls"), not parked: $reason"
  return "$DRIVER_E_REQUEUE"
}

step_fn() { printf 'driver_step_%s' "$(printf '%s' "$1" | tr '-' '_')"; }

# driver_question_names_held_claim <question> — 0 when a step's question is about a claim
# another run holds. That is a state the queue waits out, not a question: parked as one,
# #13191 sat in the PM's lane over "a peer holds the claim", which no PM can answer.
driver_question_names_held_claim() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | grep -Eq \
    '(peer|another (run|agent|session|build|worker|machine)|other (run|agent|session|machine)|sibling run)[^.?!]*(hold|has|have|took|taken|own|is on)[^.?!]*claim|claim[^.?!]*(held|taken|owned)[^.?!]*by (a |an )?(peer|another|other|sibling)|(adopt|take over|steal)[^.?!]*live claim|live claim[^.?!]*(held|peer|another)'
}

[ -f "$DRIVER_STEPS_DIR/park.sh" ] \
  || die "no park step at $DRIVER_STEPS_DIR/park.sh — every other step's refusal ends there, so nothing may start without it"
. "$DRIVER_STEPS_DIR/park.sh" || die "could not load $DRIVER_STEPS_DIR/park.sh"
command -v driver_park >/dev/null 2>&1 || die "$DRIVER_STEPS_DIR/park.sh defines no driver_park"

for s in $DRIVER_STEPS; do
  f="$DRIVER_STEPS_DIR/$s.sh"
  [ -f "$f" ] || die "the order names the step '$s' and there is no $f. A step that cannot be found is refused here, not skipped: a walk that skips it reports the same as a walk where it passed."
  . "$f" || die "could not load $f"
  command -v "$(step_fn "$s")" >/dev/null 2>&1 \
    || die "$f defines no $(step_fn "$s") — the step's file is there and the step is not."
done

# ---- the record ------------------------------------------------------------
driver_state_init "$TICKET"
if [ -n "$REPAIR_BRIEF" ]; then
  # THE SAME BRIEF RESUMES, A NEW ONE IS A NEW ROUND. A repair spawned again on the
  # same brief (a killed run) picks up where it stopped. A different brief is a new
  # failure, so the last round's answers move aside — the fix step must not read the
  # last review's findings, and the new round gets its own two review rounds.
  _rb_sha=$(git hash-object "$REPAIR_BRIEF" 2>/dev/null)
  _rd=$(driver_state_dir "$TICKET")
  # AND A ROUND IS MORE THAN ITS WORDS. The empty-note brief and the merge lane's
  # notes repeat word for word, so keyed on the brief alone the next clash on a
  # repaired PR ran reenter, said "nothing left to do" and exited 0 with the PR red.
  # A round already shipped is never resumed, and a PR whose head moved since the
  # round began is a new failure.
  _rb_head=$(driver_open_prs_for "$TICKET" 2>/dev/null | head -1 | cut -f3)
  _rb_new=0
  [ "$_rb_sha" != "$(driver_state_get "$TICKET" repair_brief_sha)" ] && _rb_new=1
  driver_state_is_done "$TICKET" ship && _rb_new=1
  [ -n "$_rb_head" ] && [ -n "$(driver_state_get "$TICKET" repair_pr_head)" ] \
    && [ "$_rb_head" != "$(driver_state_get "$TICKET" repair_pr_head)" ] && _rb_new=1
  # The park cap counts parks on ONE head, across runs: a new PR head starts it again.
  [ -n "$_rb_head" ] && [ "$_rb_head" != "$(driver_state_get "$TICKET" repair_pr_head)" ] \
    && _driver_state_edit "$TICKET" '.counters.machine_parks = 0'
  if [ "$_rb_new" -eq 1 ]; then
    _arch="$_rd/steps/archive/$(date -u +%Y%m%dT%H%M%SZ)-$$"
    mkdir -p "$_arch"
    for _f in "$_rd"/steps/*; do
      case "$(basename "$_f")" in archive|replaced.jsonl) continue ;; esac
      [ -e "$_f" ] && mv "$_f" "$_arch/"
    done
    rmdir "$_arch" 2>/dev/null || true
    driver_state_reopen "$TICKET" $DRIVER_STEPS
    _driver_state_edit "$TICKET" --arg sha "$_rb_sha" --arg h "$_rb_head" --arg src "$REPAIR_SOURCE" \
      '.counters.review = 0 | .counters.fix = 0 | .counters.selfcheck_red = 0 | .counters.push_red = 0 | .counters.ship_rework = 0 | .repair_base = "" | .repair_conflicted = "" | .repair_brief_sha = $sha | .repair_pr_head = $h | .repair_brief_source = $src'
    driver_state_set "$TICKET" run_brief ""   # a build's brief does not outlive into a repair
    driver_keep_brief "$REPAIR_BRIEF" "$_rd/repair-brief.md"
    driver_state_set "$TICKET" repair_brief "$_rd/repair-brief.md"
    driver_say "🔧 #$TICKET repair: $(head -1 "$_rd/repair-brief.md" | cut -c1-160)"
  fi
  driver_state_set "$TICKET" mode repair
  unset _rb_sha _rb_head _rb_new _rd _arch _f
else
  driver_state_set "$TICKET" mode build
  # The run's brief, kept on the record: every AI step is handed it (ai-step.sh), and a
  # resumed build still has it. A later brief replaces it; a run with none keeps it.
  if [ -n "$RUN_BRIEF" ]; then
    driver_keep_brief "$RUN_BRIEF" "$(driver_state_dir "$TICKET")/run-brief.md"
    driver_state_set "$TICKET" run_brief "$(driver_state_dir "$TICKET")/run-brief.md"
    driver_say "📝 #$TICKET brief: $(head -1 "$RUN_BRIEF" | cut -c1-160)"
  fi
fi
if [ "$RESTART" -eq 1 ]; then
  driver_state_reopen "$TICKET" $DRIVER_STEPS
  driver_say "↻ #$TICKET restarting: every step will run again."
fi

# The steps as an indexable list, because a rework rewinds to a position.
set -- $DRIVER_STEPS
STEPS=("$@")
N=${#STEPS[@]}

# Where a rework goes back to. Two answers, because they are two different
# questions.
#
# A REVIEW that graded something critical, major or minor is asking for the findings to be
# cleared, so it goes back to the FIX step — which is the only step that reads
# review.json. It used to go back to `build`, which re-ran the original plan task
# blind to what the reviewer had just found, so the two-round ceiling bounded a loop
# that could not act on anything.
#
# THE BUILD STEP sending itself back is the other one: its test did not prove the
# change, and the answer is another attempt at the same task. Sending that to `fix`
# would skip `build` entirely — `build` is earlier in the order and not finished —
# so the task would never be built at all.
BUILD_AT=-1; FIX_AT=-1
i=0
while [ "$i" -lt "$N" ]; do
  [ "${STEPS[$i]}" = "build" ] && [ "$BUILD_AT" -lt 0 ] && BUILD_AT=$i
  [ "${STEPS[$i]}" = "fix" ]   && [ "$FIX_AT"   -lt 0 ] && FIX_AT=$i
  i=$((i+1))
done

# The rework ceiling, which is the SUM of the two budgets underneath it — not
# either one of them. The build step parks itself after DRIVER_MAX_BUILD_TRIES
# unproved attempts and the reviewer stops after DRIVER_MAX_REVIEW_ROUNDS, and both
# of those return the same code, so one counter set to one of the numbers trips on a
# run that is inside both: four build failures then two review rounds is six. That
# park then accuses a step of not counting and the ticket never reaches its last
# review pass. Past the sum, no honest combination remains, so it IS a step
# returning rework without counting — which is the only thing this exists to catch.
REWORKS=0
# Plus the one repair round a red self-check may send to fix.
REWORK_CEILING=$(( DRIVER_MAX_BUILD_TRIES + DRIVER_MAX_REVIEW_ROUNDS + 2 * ${DRIVER_MAX_GATE_FIXES:-3} + 1 ))

# The steps that run on EVERY pass, finished or not. `start` is the re-entry check:
# the hold label, the ticket's state and the claim are all read there, and a park
# adds that label and releases the claim. Skipped on a resume, a ticket a person has
# taken ownership of is built anyway, and the run pushes, marks the pull request
# ready and arms auto-merge holding no claim at all — so a peer can cut a second
# worktree on the same branch in the middle of it. What makes re-running safe is
# that start is idempotent: it keeps the worktree and the branch already on the
# record rather than cutting or naming new ones.
DRIVER_ALWAYS_STEPS="${DRIVER_ALWAYS_STEPS:-start}"
always() { case " $DRIVER_ALWAYS_STEPS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# A RESUME RE-PLANS WHEN THE TICKET CHANGED. A finished plan used to be reused for
# ever, so a run resumed after the PM edited the ticket built tasks the PM had
# removed. The body the plan read is hashed onto the record; a different body now
# reopens plan and everything after it. An unreadable body, or a record from before
# the hash, compares as unchanged: there is nothing to compare.
ticket_body_hash() { # <ticket> — empty when the body cannot be read
  local b
  b=$(swarm_gh issue view "$1" --repo "$REPO_SLUG" --json body -q '.body // ""' 2>/dev/null) || return 0
  printf '%s' "$b" | git hash-object --stdin 2>/dev/null
}
PLAN_AT=-1; i=0
while [ "$i" -lt "$N" ]; do
  [ "${STEPS[$i]}" = "plan" ] && { PLAN_AT=$i; break; }
  i=$((i+1))
done
if [ "$PLAN_AT" -ge 0 ] && driver_state_is_done "$TICKET" plan; then
  planned_hash=$(driver_state_get "$TICKET" plan_body_hash)
  now_hash=$(ticket_body_hash "$TICKET")
  if [ -n "$planned_hash" ] && [ -n "$now_hash" ] && [ "$planned_hash" != "$now_hash" ]; then
    driver_state_reopen "$TICKET" "${STEPS[@]:$PLAN_AT}"
    driver_say "↻ #$TICKET changed since it was planned: back to plan, and every step after it runs again."
  fi
fi
plan_hash=""

skipped=0
ran=0        # steps that did real work — start re-checking itself is not work
# With a shared sheet, the claim carries the step, so every host's coordinator can say
# what a build is on. Best effort: before start there is no claim, and nothing waits on it.
SHARE_STEP=""; [ -z "$(driver_opt coordinator.sheet.owner "")" ] || SHARE_STEP=1
i=0
while [ "$i" -lt "$N" ]; do
  step="${STEPS[$i]}"
  # THE RUN'S OWN DIRECTORY CAN BE REMOVED UNDER IT (a sweep, a retired spawn checkout),
  # and every git call made from a cwd that is gone dies on getcwd: #13480 parked on it.
  pwd -P >/dev/null 2>&1 || { cd "$MAIN_REPO" 2>/dev/null || cd /; driver_say "   the run's directory was removed under it — carrying on from $PWD"; }
  [ -z "$SHARE_STEP" ] || bash "$CL" update "$TICKET" "step=$step" >/dev/null 2>&1 || true

  if driver_state_is_done "$TICKET" "$step" && ! always "$step"; then
    skipped=$((skipped+1)); i=$((i+1)); continue
  fi

  # Its own command, and the exit code is the verdict. Never batched with
  # anything: a step batched with the next one reports on the shell reaching
  # that line, and a printed failure mid-batch has reached the trunk before.
  rc=0
  # An always-step re-running is neither work nor a skip: counting it as skipped made
  # "N step(s) were already finished and did not run again" name the one step that did,
  # and a finished ticket report "all 7 were already finished" having run start.
  was_done=0; driver_state_is_done "$TICKET" "$step" && was_done=1
  # The body is read BEFORE the plan runs, so an edit made while it plans is a change.
  [ "$step" != "plan" ] || plan_hash=$(ticket_body_hash "$TICKET")
  RUN_LOG_FROM=$(( $( { wc -l < "$(driver_state_dir "$TICKET")/log"; } 2>/dev/null || echo 0) + 1 ))
  "$(step_fn "$step")" "$TICKET" || rc=$?
  if [ "$was_done" -eq 0 ]; then ran=$((ran+1)); fi

  # A note a step left behind. An exit code says which check said no; it cannot say
  # WHAT, and a step that knows — what a review graded critical, major or minor —
  # writes it here. Read once and cleared, so a note from an earlier
  # refusal cannot become the question a later one asks.
  note=""; asked=""; park_reason=""; park_question=""; park_cause="driver"
  # A STEP MAY SAY ITS REFUSAL NEEDS A PERSON. The exit code cannot: a gate saying
  # no and "only a person sanctions a deviation from an approved design" are both
  # DRIVER_E_REFUSED, and the second one must not leave a ticket the driver picks
  # straight back up — resuming re-runs that step, and the next answer sanctioning
  # the deviation is an agent clearing its own refusal. Read once and cleared, like
  # the note beside it.
  # A step that met a claim another live run holds says so here: its requeue must keep
  # that claim, which is the holder's, whichever step it was.
  claim_elsewhere=$(driver_state_get "$TICKET" claim_elsewhere)
  [ -z "$claim_elsewhere" ] || driver_state_set "$TICKET" claim_elsewhere ""
  step_cause=$(driver_state_get "$TICKET" park_cause)
  [ -z "$step_cause" ] || driver_state_set "$TICKET" park_cause ""
  note=$(driver_state_get "$TICKET" park_note)
  [ -z "$note" ] || driver_state_set "$TICKET" park_note ""
  # The step's own question, read HERE and not inside the case below.
  #
  # `${note:-$(jq …)}` inside a case ARM breaks bash 3.2's parser: the `)` of the
  # command substitution closes the arm, and every arm after it — including `*)` —
  # is silently swallowed. The case then matches NOTHING for a refusal, the loop
  # neither parks nor advances, and the step runs for ever. `bash -n` is happy, so
  # the only symptom is a run that hangs. Measured: 536 self-check calls, one park
  # never reached, on the stock macOS bash this kit has to run on.
  asked=$(jq -r '(.question // .park // "")' \
            "$(driver_state_dir "$TICKET")/steps/$step.json" 2>/dev/null)
  [ -n "$asked" ] || asked="see the step output"
  # WHO ANSWERS IT. Only `pm` goes to the PM — ticket shape: repo, split, order,
  # acceptance wording. Anything else, absent or unreadable included, is the owner's:
  # a question of his routed to the PM is one he never sees.
  asked_for=$(jq -r '.questionFor // ""' \
            "$(driver_state_dir "$TICKET")/steps/$step.json" 2>/dev/null)
  ask_cause="person"
  [ "$asked_for" != "pm" ] || ask_cause="pm"

  # WHY THE ARMS ONLY ASSIGN, measured rather than guessed.
  #
  # An arm here used to pass `"${note:-some literal text}"` to driver_park. In bash 3.2 —
  # the stock macOS shell this kit runs on — an APOSTROPHE inside `${var:-…}` opens a
  # single-quote context even within double quotes. One of them is a loud unterminated-
  # quote error that `bash -n` catches. TWO of them BALANCE, so `bash -n` returns 0 and
  # everything between the pair is swallowed — here, the arms between them and `*)`. The
  # case then matched nothing for a refusal, the loop neither parked nor advanced, and
  # the step ran for ever: measured at 573 self-check calls with the park never reached,
  # on a file `bash -n` accepted.
  #
  # Bisected: `$( )` inside a `${:-}` default in an arm is FINE; one apostrophe fails
  # loudly; two apostrophes fail silently. So the rule is not about command substitution
  # and it is not about `case` — it is that a pair of apostrophes inside `${:-}` defeats
  # the syntax check. The arms therefore set two plain variables and the park happens
  # once, after the esac, where no default-expansion appears at all.
  park_reason=""; park_question=""; unread=0; requeue=0; to_repair=0; claim_busy=0
  [ -z "$claim_elsewhere" ] || claim_busy=1
  PARK_HOST=$(hostname -s 2>/dev/null || hostname 2>/dev/null)
  PARK_LOG="$(driver_state_dir "$TICKET")/log"
  case "$rc" in
    "$DRIVER_OK")
      driver_state_done "$TICKET" "$step"
      [ "$(driver_state_get "$TICKET" '.counters.requeue // 0')" = 0 ] || _driver_state_edit "$TICKET" '.counters.requeue = 0'
      [ "$step" != "plan" ] || driver_state_set "$TICKET" plan_body_hash "$plan_hash"
      i=$((i+1))
      ;;

    "$DRIVER_E_REWORK")
      # The build step's own rework is another try at the same task; anybody else's
      # is the findings to clear, which only the fix step can read.
      rework_at="$BUILD_AT"
      if [ "$step" != "build" ] && [ "$FIX_AT" -ge 0 ]; then rework_at="$FIX_AT"; fi
      if [ "$rework_at" -lt 0 ]; then
        park_reason="$step asked for a rework and this run has no build step to go back to"
        park_question="Should the order include a build step, or should $step stop asking for one?"
      else
        REWORKS=$((REWORKS+1))
        if [ "$REWORKS" -gt "$REWORK_CEILING" ]; then
          park_reason="the rework loop did not settle: $REWORKS rounds and $step is still sending the work back"
          park_question="The build step parks itself at $DRIVER_MAX_BUILD_TRIES tries and the reviewer stops after $DRIVER_MAX_REVIEW_ROUNDS rounds, so a loop past their sum is a step returning rework without counting. Which is it?"
        else
          # Everything from there onwards has to happen again, so it has to leave the
          # finished list — otherwise the resumed walk skips the very steps the
          # rework exists to repeat.
          driver_state_reopen "$TICKET" "${STEPS[@]:$rework_at}"
          driver_say "↩ rework round $REWORKS: back to ${STEPS[$rework_at]} (${step} sent it back)"
          i="$rework_at"
        fi
      fi
      ;;

    "$DRIVER_E_QUESTION")
      # THE ONE PARK A PERSON OWNS. Every other exit here is this kit, a gate or
      # this project's own configuration stopping, and putting the hold label on
      # those hid #10907 behind a human-only label for a defect of the driver's —
      # which the next trial then refused to start on, because an agent clearing an
      # approval label to unblock itself is the thing that must never be automated.
      # A QUESTION ABOUT A HELD CLAIM IS A WAIT, not a question: it goes back on the
      # queue exactly as a step's DRIVER_E_BUSY does, the holder's claim untouched.
      if driver_question_names_held_claim "$asked"; then
        requeue=1; claim_busy=1
        [ -n "$note" ] || note="$asked"
      else
        park_reason="$step asked a question rather than guessing"
        park_question="$asked"
        park_cause="$ask_cause"
      fi
      ;;

    "$DRIVER_E_NO_SKILL")
      park_reason="$step did not run the Skill its brief names"
      park_question="Inside a ticket Superpowers does the work. Is the brief naming the wrong Skill, or is it not installed?"
      ;;

    "$DRIVER_E_SCHEMA")
      park_reason="$step answered in a shape the driver cannot read"
      park_question="Is the brief's Return section in step with briefs/schemas/$step.json?"
      ;;

    "$DRIVER_E_NO_BRIEF")
      park_reason="there is no brief for the $step step"
      park_question="The briefs are a separate deliverable — has briefs/$step.md landed yet?"
      ;;

    "$DRIVER_E_UNREAD")
      unread=1
      ;;

    "$DRIVER_E_USAGE"|"$DRIVER_E_BUSY")
      requeue=1
      ;;

    "$DRIVER_E_TO_REPAIR")
      to_repair=1
      ;;

    "$DRIVER_E_TIMEOUT")
      park_reason="$step ran past its time limit"
      park_question="Something it ran does not return — a watch-mode test runner is the usual cause. Which command was it?"
      ;;

    *)
      # Everything else, including DRIVER_E_REFUSED. A gate said no, and the local
      # gate IS the gate: nothing goes past it and the claim is not held while
      # somebody works out why.
      park_reason="$step refused (exit $rc)"
      park_question=$(driver_last_refusal "$step")
      [ -n "$park_question" ] || park_question="$step left no reason on the record. Its own lines are in the run log on $PARK_HOST at $PARK_LOG"
      ;;
  esac

  # NOBODY'S TO ANSWER, AND GONE BY A LATER RUN: GitHub unreadable (a 504 parked every
  # ready ticket it reached on 2026-10-19), the plan's usage limit, a claim another run
  # on this host holds. A park is never retried, so these go back on the queue instead.
  # One that comes back run after run is not an outage passing: past the cap it parks,
  # carrying the step's own reason. The usage limit has no cap: it clears at its reset.
  if [ "$unread" -eq 1 ] || [ "$requeue" -eq 1 ]; then
    requeue_why="$note"
    [ -n "$requeue_why" ] || requeue_why=$(driver_last_refusal "$step")
    [ -n "$requeue_why" ] || requeue_why="$step stopped on something that clears by itself (exit $rc)"
    if [ "$rc" != "$DRIVER_E_USAGE" ]; then
      driver_state_bump "$TICKET" requeue
      # A claim lasts as long as its holder's run, or until the reconciler frees it: a longer wait.
      _cap="${DRIVER_MAX_REQUEUES:-3}"
      if [ "$rc" = "$DRIVER_E_BUSY" ] || [ "$claim_busy" -eq 1 ]; then _cap="${DRIVER_MAX_BUSY_REQUEUES:-10}"; fi
      if [ "$(driver_state_get "$TICKET" '.counters.requeue // 0')" -gt "$_cap" ]; then
        park_reason="$step could not go on for $_cap requeued runs in a row"
        park_question="$requeue_why"; unread=0; requeue=0
      fi
    fi
  fi
  if [ "$unread" -eq 1 ] || [ "$requeue" -eq 1 ]; then
    # start and reenter stop before they take the claim, so one held now is a peer's.
    case "$step" in start|reenter) _keep=keep ;; *) _keep="" ;; esac
    [ "$claim_busy" -eq 0 ] || _keep=keep
    driver_requeue "$TICKET" "$requeue_why" "$_keep"
    [ "$unread" -eq 0 ] || exit "$DRIVER_E_UNREAD"
    exit "$DRIVER_E_REQUEUE"
  fi

  # THE TICKET'S OPEN PR IS WORKED, NOT PARKED ON. start found one, so the run turns
  # into a repair of it: the record leaves build mode (an unshipped build would route
  # the run straight back here) and this script runs again as --repair, carrying the
  # brief this run was sent, or as a note-less healing repair. Once per run.
  if [ "$to_repair" -eq 1 ] && [ -z "${DRIVER_SWITCHED_TO_REPAIR:-}" ]; then
    _rb=$(driver_state_get "$TICKET" run_brief); [ -n "$_rb" ] && [ -s "$_rb" ] || _rb="${RUN_BRIEF:-}"
    driver_state_set "$TICKET" mode repair
    driver_state_set "$TICKET" run_brief ""
    export DRIVER_SWITCHED_TO_REPAIR=1
    if [ -n "$_rb" ] && [ -s "$_rb" ]; then
      _sw="$(driver_state_dir "$TICKET")/repair-brief.from-start.md"
      _pn=$(driver_state_get "$TICKET" repair_pr)
      { printf '#%s already has an open pull request%s, so this run repairs it rather than build a second branch. The brief the run was sent with follows.\n\n' \
          "$TICKET" "${_pn:+ (#$_pn)}"; cat "$_rb"; } > "$_sw.tmp" && mv "$_sw.tmp" "$_sw"
      driver_say "↪ #$TICKET becomes a repair of its open pull request, carrying its brief"
      exec bash "$DRIVER_HOME_SELF/build-ticket" "$TICKET" --repair "$_sw"
    fi
    driver_say "↪ #$TICKET becomes a repair of its open pull request"
    exec bash "$DRIVER_HOME_SELF/build-ticket" "$TICKET" --repair-class repair
  elif [ "$to_repair" -eq 1 ]; then
    park_reason="$step found an open pull request again after this run had already turned into a repair of it"
    park_question=$(driver_last_refusal "$step")
    [ -n "$park_question" ] || park_question="#$TICKET's open pull request was handed to a repair, and start ran again. Which run owns it?"
  fi

  # A note the step left on the record outranks the wording above: it is the actual
  # finding rather than a description of the code that stopped.
  if [ -n "$park_reason" ]; then
    [ -z "$note" ] || park_question="$note"
    [ -z "$step_cause" ] || park_cause="$step_cause"
    driver_park "$TICKET" "$park_reason" "$park_question" "$park_cause"
    exit "$DRIVER_E_QUESTION"
  fi
done

if [ "$ran" -eq 0 ]; then
  driver_say "✓ #$TICKET has nothing left to do — all $skipped step(s) were already finished."
  exit "$DRIVER_OK"
fi
[ "$skipped" -eq 0 ] \
  || driver_say "   resumed: $skipped step(s) were already finished and did not run again."
# "shipped" IS THE SHIP STEP, not the end of the loop. `--steps start` printed
# "✓ #10907 shipped: start" on the 2026-09-27 trial, about a run that had claimed a
# ticket and done nothing else — and a completion line that says the same thing
# however far a run got is a line nobody can read a verdict off.
if driver_state_is_done "$TICKET" ship; then
  driver_say "✓ #$TICKET shipped: $(driver_state_get "$TICKET" 'done|join(" · ")')"
else
  driver_say "✓ #$TICKET ran $(driver_state_get "$TICKET" 'done|join(" · ")') — not shipped: the order given did not reach the ship step."
fi
exit "$DRIVER_OK"
